# Supabase authentication and database access
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Groq is used only when the deterministic bank parser cannot parse a Union Bank message.
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-20b

# Server-only keyring for the staged financial encryption migration.
# Each key is a 32-byte value encoded as base64url. Keep the lookup key separate.
FINANCIAL_ENCRYPTION_ACTIVE_KEY=
FINANCIAL_ENCRYPTION_KEYRING=
FINANCIAL_LOOKUP_KEY=
FINANCIAL_SCHEDULER_TOKEN=
FINANCIAL_SCHEDULER_URL=
